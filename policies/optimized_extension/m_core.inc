/* m_core.inc: rule-table plumbing. Core steps of the rule table: per-step preludes shared by every module (goal marker, Fire-phase flag, distance maps, current floor record) and the fallback.
 * Generated by mod/tools/make_mod.py from policy/full_policy.c (autonomous()). */
/* Locals of the original autonomous() shared by several steps; each is assigned by the step that
 * declared it in the original, at the same point of the order. */
typedef struct {
 int fire;
 int prep;
 int troll_low;
 int hold;
 int routed;
 int unseen_level;
 int vault_calm;
 int needs_healing;
 FPFloor *f;
 int prepare;
 int ready;
 int fired;
} FPRuleCtx;
/* RET: emit this action with this skill (the original `return emit(a,o,s,action,skill)`).
 * TRY: the original macro: emit the expression's action if it is >= 0. */
#define RET(action_,skill_) do {int ret_=(action_);*skill=(skill_);ctx->fired=1;return ret_;} while(0)
#define TRY(expression,skill_) do {act=(expression);if(act>=0)RET(act,skill_);} while(0)

/* [0] p_init (CORE): Clear the goal marker; compute the Fire-phase flag (ctx->fire). */
static int p_init(FPAgent *a,const FPObservation *o,const FPConfig *cfg,FPScratch *s,FPRuleCtx *ctx,int *skill) {
 a->goal=-1;
 ctx->fire=fire_phase(a);
 return -1;
}

/* [12] p_routed_paths (CORE): Realm floors: compute distance maps (paths) before retreat rules (ctx->routed). */
static int p_routed_paths(FPAgent *a,const FPObservation *o,const FPConfig *cfg,FPScratch *s,FPRuleCtx *ctx,int *skill) {
 /* Realm retreats follow the route to the up ladder (tactical). */
 ctx->routed=a->level==4 || a->level==5 || a->level==6 || a->level==7 || (a->level==1 && !a->floors[5].seen);
 if(ctx->routed)paths(a,o,cfg,s);
 return -1;
}

/* [27] p_paths (CORE): Non-realm floors: compute distance maps (paths). */
static int p_paths(FPAgent *a,const FPObservation *o,const FPConfig *cfg,FPScratch *s,FPRuleCtx *ctx,int *skill) {
 if(!ctx->routed)paths(a,o,cfg,s);
 return -1;
}

/* [89] p_floor_prepare (CORE): Current floor record (ctx->f) and Overworld preparation window (ctx->prepare). */
static int p_floor_prepare(FPAgent *a,const FPObservation *o,const FPConfig *cfg,FPScratch *s,FPRuleCtx *ctx,int *skill) {
 ctx->f=&a->floors[a->level];
 ctx->prepare=a->level==0 && ctx->f->steps<cfg->prepare_steps;
 return -1;
}

/* [143] r_idle (CORE): Fallback: no-op. */
static int r_idle(FPAgent *a,const FPObservation *o,const FPConfig *cfg,FPScratch *s,FPRuleCtx *ctx,int *skill) {
 RET(FP_NOOP,FP_EXPLORE);
 return -1;
}
