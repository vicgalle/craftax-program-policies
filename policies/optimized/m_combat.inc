  if(shallow(a) && a->level==2 && place_failed && o->inv[FP_I_TORCH] && (act=place(a,o,s,FP_PLACE_TORCH))>=0 && act!=FP_PLACE_TORCH)RET(act,FP_LIGHT);
  if(inside(r,c)) {
