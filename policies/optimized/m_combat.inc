}

/* [138] r_hunt_prey (COMBAT): Fire elementals keep four or five cells away and walk on lava; chased, they end cornered and fire point-blank. */
static int r_hunt_prey(FPAgent *a,const FPObservation *o,const FPConfig *cfg,FPScratch *s,FPRuleCtx *ctx,int *skill) {
 int act=-1;
 /* A cleared Dungeon only needs its ladder. Distant hunts there kept agents
  * fighting near the entrance for hundreds of steps instead of exploring;
  * approaching mobs still meet the adjacent-combat rules. */
/* Fire elementals keep four or five cells away and walk on lava; chased,
  * they end cornered and fire point-blank. 74 of 87 sampled fireball hits
  * came from one or two cells. Clear Fire on the pigmen that come to us. */
 int prey=ctx->fire && a->level==6?1:5;
 /* Troll Mines: deep things come only to a pool's edge, and walking up to
  * strike one took 3.1 slimeball hits per 1,000 steps (the highest rate of any
  * activity). Trolls come to us; on the cleared floor hunts only cost time. */
 if(TB(11) && a->level==5 && troll_phase(a))prey=o->clear?0:1;
 if(prey && o->inv[FP_I_SWORD]>=2 && (a->level>0 || !a->achieved[8] || !a->achieved[12]))TRY(hunt(a,o,s,prey,a->level==1 && o->clear?3:30),FP_FIGHT);
 return -1;
}

/* ==== combat stream (push50 work/combat) ==== */
#define CB_RUBY 0
#define CB_LOWFLEE 5
#define CB_SNIPE 0
#define CB_CROWD 0
#define CB_CLIGHT 0
#define CB_COAL 1
/* combat prototypes (work/combat): Troll Mines only (level 5). All switches default off (= incumbent). */
/* RUBY (build): the cleared-mines ruby search explores for rubies only with a pickaxe that can mine them. */
#ifndef CB_RUBY
#define CB_RUBY 0
#endif
#ifndef CB_SNIPE
#define CB_SNIPE 0
#endif
#ifndef CB_CLIGHT
#define CB_CLIGHT 0
#endif
#ifndef CB_CROWD
#define CB_CROWD 0
#endif
/* SNIPE: a deep thing has 4 health; one fireball, iceball, arrow or blow kills it, and each kill counts
 * towards the 8 that open the ladder. tactical() fires along the faced axis only. Turn to face a known deep
 * thing on our row or column (distance 2-5, clear line, no unknown cell between) when a shot is available
 * and no melee mob is within 3. Turning is free into a blocked neighbour; into an open one it is a step
 * along the line, taken only from distance 3+. */
static int cb_snipe(FPAgent *a,const FPObservation *o,FPScratch *s) {
 if(!CB_SNIPE || a->level!=5)return -1;
 int spell=o->mana>=2 && (o->spells[0]||o->spells[1]),bow=o->bow && o->inv[FP_I_ARROW]>0;
 if(!spell && !bow)return -1;
 if(wm_melee_within(a,3))return -1;
 int best=0,bk=99;
 for(int i=0;i<a->enemy_count;i++) {
  FPEnemy e=a->enemies[i];if(!e.kind || e.type!=6)continue;
  int er=e.p/FP_SIDE-a->r,ec=e.p%FP_SIDE-a->c,k=abs(er)+abs(ec);
  if((er && ec) || k<2 || k>5)continue;
  int sr=er>0?1:er<0?-1:0,sc=ec>0?1:ec<0?-1:0,ok=1;
  for(int j=1;j<k;j++){int b=block(a,a->r+j*sr,a->c+j*sc);if(solid(b)||b==UNKNOWN){ok=0;break;}}
  if(!ok)continue;
  int want=er>0?FP_DOWN:er<0?FP_UP:ec>0?FP_RIGHT:FP_LEFT;
  if(want==o->dir)return -1;            /* already facing: tactical() shoots */
  if(!known_direction(a,want))continue;
  int nr=a->r+dr[want],nc=a->c+dc[want];
  if(inside(nr,nc) && walkable(block(a,nr,nc)) && !s->mobs[cell(nr,nc)] && k<3)continue;
  if(k<bk){bk=k;best=want;}
 }
 return best?best:-1;
}
/* CLIGHT: trolls on unlit cells are invisible to the WM, the shield and tactical(). With a troll known within
 * 6 and no melee mob adjacent, light our surroundings when many cells within 3 are still unknown. */
static int cb_clight(FPAgent *a,const FPObservation *o,FPScratch *s) {
 if(!CB_CLIGHT || a->level!=5 || o->inv[FP_I_TORCH]<8)return -1;
 if(!wm_melee_within(a,6) || wm_melee_within(a,1))return -1;
 if(wm_incoming_damage(a,o,s,FP_NOOP)>0)return -1;
 int unk=0;
 for(int r=-3;r<=3;r++)for(int c=-3;c<=3;c++)if(abs(r)+abs(c)<=3 && inside(a->r+r,a->c+c) && block(a,a->r+r,a->c+c)==UNKNOWN)unk++;
 if(unk<CB_CLIGHT)return -1;
 int fr=a->r+dr[o->dir],fc=a->c+dc[o->dir];
 if(inside(fr,fc) && place_valid(a,s,cell(fr,fc),FP_PLACE_TORCH))return FP_PLACE_TORCH;
 return -1;
}
/* CROWD: with two or more melee mobs known within 6 (a troll blow costs half the health bar at iron armour),
 * waiting in place for the nearest one lets the second arrive before the first is dead. Step to the
 * neighbour that keeps the most distance from every known melee mob, preferring the route to the up ladder. */
static int cb_crowd(FPAgent *a,const FPObservation *o,FPScratch *s) {
 if(!CB_CROWD || a->level!=5)return -1;
 int n=0;for(int i=0;i<a->enemy_count;i++)if(!a->enemies[i].kind && abs(a->enemies[i].p/FP_SIDE-a->r)+abs(a->enemies[i].p%FP_SIDE-a->c)<=6)n++;
 if(n<2 || wm_melee_within(a,1))return -1;
 if(o->health>=2*wm_attack_damage(o,6)+1)return -1;
 int up=a->floors[5].up,first=up>=0 && s->dist[up]<INF?s->first[up]:0;
 int best=-1;float bs=-1e9f;
 for(int d=1;d<=4;d++) {
  int r=a->r+dr[d],c=a->c+dc[d];
  if(!inside(r,c)||!walkable(block(a,r,c))||s->mobs[cell(r,c)]||s->arrow_next[cell(r,c)])continue;
  float sc=0;int mind=99;
  for(int i=0;i<a->enemy_count;i++)if(!a->enemies[i].kind){int dd=abs(a->enemies[i].p/FP_SIDE-r)+abs(a->enemies[i].p%FP_SIDE-c);if(dd<mind)mind=dd;sc+=dd;}
  if(mind<=1)continue;
  sc+=4*mind+(d==first?3:0);
  if(sc>bs){bs=sc;best=d;}
 }
 return best;
}

/* LOWFLEE: at troll_low health (one more troll blow leaves < 3), tactical()'s facing wait holds the agent still
 * while a troll approaches (the incumbent's TB(19), the same hold made explicit, cost -7.7pp). With no melee mob
 * adjacent and nothing incoming, and a troll known within 6, take the route to the up ladder (<= 150 steps) now;
 * a pursuing melee mob never strikes a player who keeps moving away, and mobs never follow a ladder. */
#ifndef CB_LOWFLEE
#define CB_LOWFLEE 0
#endif
static int cb_lowflee(FPAgent *a,const FPObservation *o,FPScratch *s) {
 /* bit 1: Troll Mines (troll blow); bit 2: Ice-phase Fire crossings (pigman blow 6.2+ in ice armour; the
  * Fire-phase retreat rule r_fire_low_retreat does not apply there, the drink/health<=4 leave comes later);
  * bit 4: Troll Mines after a slimeball hit (troll_slime_t, within 30 steps) when one more would kill: the deep
  * thing is usually unseen (30 of 113 fatal slimeball hits had a known shooter within 6). */
 int mines=(CB_LOWFLEE&1) && a->level==5,fire=(CB_LOWFLEE&2) && a->level==6 && icetrip(a);
 int slime=(CB_LOWFLEE&4) && a->level==5 && a->troll_slime_t && a->t-a->troll_slime_t<=30 && o->health<=wm_slimeball_damage(o)+1;
 if(!mines && !fire && !slime)return -1;
 if(!slime) {
  float hit=wm_attack_damage(o,mines?6:7);
  if(!(o->health<8+o->str-0.01f && o->health-hit<3))return -1;
  if(!wm_melee_within(a,6))return -1;
 }
 if(wm_melee_within(a,1) || wm_incoming_damage(a,o,s,FP_NOOP)>0)return -1;
 if(sealed_in(a,o,s))return -1;
 int up=a->floors[a->level].up;if(up<0 || s->dist[up]>(a->level==5?150:250))return -1;
 return travel(a,o,s,0);
}

/* [combat] r_cb_lowflee (COMBAT): Troll Mines at troll_low health, troll within 6, none adjacent: route to the up ladder. */
static int r_cb_lowflee(FPAgent *a,const FPObservation *o,const FPConfig *cfg,FPScratch *s,FPRuleCtx *ctx,int *skill) {
 int act=-1;(void)cfg;(void)ctx;
 act=cb_lowflee(a,o,s);if(act>=0)RET(act,FP_TRAVEL);
 return -1;
}
/* [combat] r_cb_guard (COMBAT): Troll Mines, no melee mob within 2, nothing incoming: CROWD (step away from 2+
 * known melee mobs within 6 when two blows would kill) and CLIGHT (light unknown surroundings with a troll near). */
static int r_cb_guard(FPAgent *a,const FPObservation *o,const FPConfig *cfg,FPScratch *s,FPRuleCtx *ctx,int *skill) {
 int act=-1;(void)cfg;(void)ctx;
 if(a->level!=5 || wm_melee_within(a,2) || wm_incoming_damage(a,o,s,FP_NOOP)>0)return -1;
 act=cb_crowd(a,o,s);if(act>=0)RET(act,FP_FIGHT);
 act=cb_clight(a,o,s);if(act>=0)RET(act,FP_LIGHT);
 return -1;
}
/* [combat] r_cb_snipe (COMBAT): Troll Mines: turn to face a known deep thing in line so tactical() shoots it. */
static int r_cb_snipe(FPAgent *a,const FPObservation *o,const FPConfig *cfg,FPScratch *s,FPRuleCtx *ctx,int *skill) {
 int act=-1;(void)cfg;(void)ctx;
 act=cb_snipe(a,o,s);if(act>=0)RET(act,FP_FIGHT);
 return -1;
}

