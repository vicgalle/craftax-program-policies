  int quiet=!TB(0) || !troll_phase(a) || (!wm_melee_within(a,10) && o->health>=6.5f);
  if(TB(0) && troll_phase(a))for(int i=0;i<a->enemy_count;i++)if(a->enemies[i].kind)quiet=0;
