}

/* ==== build stream (push50 work/combat) ==== */
/* COAL: the Gnomish Mines are dark; torches (1 wood + 1 coal -> 4) are how the program finds the diamonds of
 * the diamond sword and the iron of the armour. 58% of the Sewers arrivals that still carry an iron sword hold
 * at most 2 torches (most 0) and no coal, 88% of those with an empty armour slot and wood in hand: the light
 * ran out and the timed descent followed (c1dev arrive3; Sewers pass .78 vs .99 with a diamond sword).
 * Entry   Sewers not seen, on the Gnomish Mines, floor clear, torches <= 2, no coal, an iron sword or an empty
 *         armour slot, 2+ wood, no hostile within 4, health >= 6, never taken before.
 * Policy  raise the incumbent's resupply flag (it climbs to the Overworld); there, mine coal (known within 300)
 *         and craft torches until CB_COAL_TORCH torches and 3 coal per empty slot are in hand.
 * Done    on the Overworld with that stock; abandon after CB_COAL_BUDGET steps on the Overworld. */
#ifndef CB_COAL
#define CB_COAL 0
#endif
#ifndef CB_COAL_TORCH
#define CB_COAL_TORCH 20
#endif
#ifndef CB_COAL_BUDGET
#define CB_COAL_BUDGET 1500
#endif
static int cb_coaltrip(FPAgent *a,const FPObservation *o,const FPConfig *cfg,FPScratch *s,int *skill) {
 if(!CB_COAL || a->floors[3].seen)return -1;
 int empty=0;for(int i=0;i<4;i++)empty+=o->armour[i]==0;
 if(a->cb_coal==0) {
  if(a->level==2 && o->clear && o->inv[FP_I_TORCH]<=2 && o->inv[FP_I_COAL]==0 && (o->inv[FP_I_SWORD]<4 || empty) &&
     o->inv[FP_I_WOOD]>=2 && !wm_hostile_within(a,4) && o->health>=6 && !a->resupplying) {
   a->cb_coal=1;a->cb_coal_t=-1;a->resupplying=1;a->resupply_tick=a->t;
  }
  return -1;
 }
 if(a->cb_coal!=1)return -1;
 if(a->level!=0){a->resupplying=1;return -1;}   /* the incumbent's resupply rule climbs */
 if(a->cb_coal_t<0)a->cb_coal_t=a->t;
 int coal_need=3*empty;if(coal_need>9)coal_need=9;
 if((o->inv[FP_I_TORCH]>=CB_COAL_TORCH && o->inv[FP_I_COAL]>=coal_need) || a->t-a->cb_coal_t>CB_COAL_BUDGET){a->cb_coal=2;return -1;}
 a->resupplying=1;
 int act=-1;
 if(o->inv[FP_I_TORCH]<CB_COAL_TORCH && o->inv[FP_I_COAL]>coal_need && o->inv[FP_I_WOOD]>=2){act=craft(a,o,cfg,s,FP_MAKE_TORCH);*skill=FP_CRAFT;}
 if(act<0 && o->inv[FP_I_PICK]>=1){act=seek_block(a,o,s,FP_COAL,300);*skill=FP_GATHER;}
 if(act<0 && o->inv[FP_I_WOOD]<4){act=seek_block(a,o,s,FP_TREE,300);*skill=FP_GATHER;}
 if(act<0){act=frontier_walk(a,o,cfg,s);*skill=FP_EXPLORE;}
 return act;
}

/* [build] r_cb_coal (BUILD): Gnomish Mines out of light (no torch, no coal) with an iron sword or an empty armour
 * slot: a coal/torch resupply trip to the Overworld (see cb_coaltrip). */
static int r_cb_coal(FPAgent *a,const FPObservation *o,const FPConfig *cfg,FPScratch *s,FPRuleCtx *ctx,int *skill) {
 int act=-1,sk=FP_GATHER;(void)ctx;
 act=cb_coaltrip(a,o,cfg,s,&sk);if(act>=0)RET(act,sk);
 return -1;
}
