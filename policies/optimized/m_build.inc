/* [39] r_ice_enchant_visit (BUILD): With the ice-armour trip pending, every Ice step is taken in fire armour (frost troll hits 5.8-7.4; 4% of entrants died on this first visit, p90 126 steps spent drinking or healing). */
static int r_ice_enchant_visit(FPAgent *a,const FPObservation *o,const FPConfig *cfg,FPScratch *s,FPRuleCtx *ctx,int *skill) {
 int act=-1;
 /* With the ice-armour trip pending, every Ice step is taken in fire armour
  * (frost troll hits 5.8-7.4; 4% of entrants died on this first visit, p90
  * 126 steps spent drinking or healing). Fire is the safer floor in fire
