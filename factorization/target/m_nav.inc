/* [110] r_torch_spread_gems (NAV): Dark floors (2,5,7,8): place a torch where it reveals enough unseen cells; then Ice diamonds and nearby sapphires/rubies/diamonds. */
static int r_torch_spread_gems(FPAgent *a,const FPObservation *o,const FPConfig *cfg,FPScratch *s,FPRuleCtx *ctx,int *skill) {
 int act=-1;
 if(a->level==2||a->level==5||a->level==7||a->level==8) {
  /* Spread permanent light only where it reveals new terrain. */
  int r=a->r+dr[o->dir],c=a->c+dc[o->dir],gain=0;
  if(inside(r,c) && o->inv[8] && place_valid(a,s,cell(r,c),FP_PLACE_TORCH)) {
   for(int rr=-4;rr<=4;rr++)for(int cc=-4;cc<=4;cc++)
    if(rr*rr+cc*cc<=22 && inside(r+rr,c+cc) && ctx->f->map[cell(r+rr,c+cc)]==UNKNOWN)gain++;
   /* Coal and resupply trips limit exploration. Walk farther into existing
    * light before spending another torch on mostly overlapping terrain. */
   /* Ice needs closer torch spacing to expose its ladder before scarce
    * food forces another dangerous return through Fire. */
   /* Graveyard has no return ladder or renewable torch materials. Broader
    * placements preserve enough light to find the boss and stranded mobs. */
   /* Ice: same spacing as the lighting explorer (ICE_TORCH_GAIN); ten new
    * cells per torch exhausted coal long before the exit was found. */
   int need=a->level==8?GRAVEYARD_TORCH_GAIN:a->level==7?ICE_TORCH_GAIN:30;
   if(TB(21) && a->level==5 && troll_phase(a) && o->clear && a->floors[5].down<0)need=40;
   if(gain>=need)RET(FP_PLACE_TORCH,FP_LIGHT);
  }
  /* Ice hits are mostly physical (frost troll 4, iceball 4, x(1-0.1 armour)):
   * full diamond plates at Ice arrival were worth +22pp P(8) (armour oracle).
   * Ice rock holds ~5 diamonds; mine those that lighting exposes. */
  if(a->level==7 && wm_armour(o)<8 && o->inv[FP_I_PICK]>=3)TRY(seek_block(a,o,s,FP_DIAMOND,40),FP_GATHER);
  int stock=a->level==5?4:1,rstock=a->level==2?4:stock;
  /* Icetrip: lighting the mines for diamonds also shows gems. After Ice a
   * ruby has no use (fire enchants are for the first Fire expedition) and a
   * sapphire only for a piece not yet ice-enchanted; mining them cost ~180
   * steps per run in traces of the prospecting candidate. */
  if(ICETRIP_GEMS && icetrip(a)) {
   int ice=0;for(int i=0;i<4;i++)ice+=o->armour_enchant[i]==2;
   stock=4-ice;rstock=0;
  }
  if(o->inv[FP_I_PICK]>=4 && o->inv[5]<stock)TRY(seek_block(a,o,s,FP_SAPPHIRE,40),FP_GATHER);
  /* Nearby mine rubies can protect the entire expedition at the Vault. */
  if(o->inv[FP_I_PICK]>=4 && o->inv[6]<rstock)TRY(seek_block(a,o,s,FP_RUBY,40),FP_GATHER);
  /* The mines hold the most diamonds. Each diamond plate takes 0.6 off a
   * troll hit, and two let full health absorb two hits with margin. */
  if(a->level==5 && o->inv[FP_I_SWORD]>=4 && o->inv[FP_I_PICK]>=4 && wm_armour(o)<8 && o->inv[4]<3)TRY(seek_block(a,o,s,FP_DIAMOND,40),FP_GATHER);
 }
 return -1;
}

/* [112] r_troll_exit_light (NAV): Exit search in the dark: 5% of entrants clear the mines and never find the ladder (ep 27: 30 torches spent by the walking torch rule, then 22,000 unlit steps). */
static int r_troll_exit_light(FPAgent *a,const FPObservation *o,const FPConfig *cfg,FPScratch *s,FPRuleCtx *ctx,int *skill) {
 int act=-1;
 /* Exit search in the dark: 5% of entrants clear the mines and never find the
  * ladder (ep 27: 30 torches spent by the walking torch rule, then 22,000
  * unlit steps). After a long search, walk to the placement that lights
  * the most unseen cells, keeping a reserve for Ice. */
 if(TB(4) && a->level==5 && troll_phase(a) && o->clear && ctx->f->down<0 && ctx->f->steps>=2000 && o->inv[FP_I_TORCH]>10)
  TRY(light_unseen(a,o,s,20,600),FP_LIGHT);
 return -1;
}

/* [121] p_ready (NAV): Descent readiness for the current floor (ctx->ready): kit or step budget. */
static int p_ready(FPAgent *a,const FPObservation *o,const FPConfig *cfg,FPScratch *s,FPRuleCtx *ctx,int *skill) {
 ctx->ready=a->level==0?(o->inv[FP_I_SWORD]>=3 && o->inv[FP_I_PICK]>=3 && o->inv[0]>=cfg->wood_stock):
   (a->level==2||a->level==5)?(o->inv[FP_I_SWORD]>=4 && o->inv[FP_I_PICK]>=4 && wm_armour(o)>=2):1;
 if(a->level==0 && ctx->f->steps>=cfg->prepare_steps)ctx->ready=1;
 if((a->level==2||a->level==5) && ctx->f->steps>=cfg->mine_steps)ctx->ready=1;
 return -1;
}

/* Descent guard (nav candidate "dguard"). Mobs never follow a ladder, and a
 * mob left beside it stays frozen there until we come back. Escapes up a ladder
 * at low health were undone at once by this rule: the floor above is clear and
 * the agent ready, so it descended on its next step into the mob it had fled
 * and took the blow on arrival (Ice-entry bank c1dev arrive7: 22 of 200
 * deaths, Fire -> Troll Mines escapes at ~4.6 health, back on Fire 0-1 steps
 * later, killed by the frozen pigman). After a climb from the floor below that
 * arrived under one of its blows plus a margin, go back down only with that
 * margin: heal here first (or let the supply rules take over). */
#ifndef DG_MARGIN
#define DG_MARGIN 2.5f
#endif
static float nav_floor_hit(const FPObservation *o,int L) {
 static const int type[8]={1,3,2,4,5,6,7,8};
 return L>=0 && L<8?wm_attack_damage(o,type[L]):0;
}
#ifndef DG_FROM
#define DG_FROM 7 /* active once this floor has been seen (7: the Ice phase only, inert before Ice) */
#endif
static int nav_descent_blocked(const FPAgent *a,const FPObservation *o) {
 if(!a->floors[DG_FROM].seen)return 0;
 if(a->nav_ent_t<=0 || a->nav_ent_from!=a->level+1)return 0;
 float safe=fminf(nav_floor_hit(o,a->level+1)+DG_MARGIN,8+o->str-0.01f);
 return a->nav_ent_hp10<safe*10 && o->health<safe;
}
/* [128] r_descend_ready (NAV): Cleared, ready, not resupplying, healthy: travel down. */
static int r_descend_ready(FPAgent *a,const FPObservation *o,const FPConfig *cfg,FPScratch *s,FPRuleCtx *ctx,int *skill) {
 int act=-1;
 if(a->level<8 && o->clear && ctx->ready && !a->resupplying && o->health>cfg->retreat_health && !(ctx->prep==1 && a->level==5)) {
  if(nav_descent_blocked(a,o)) {
   /* Heal here when the supplies allow it (the recovery rule's own entry). */
   if(o->food>2 && o->drink>2){a->recovering=1;TRY(recover(a,o,s),FP_RECOVER);}
   return -1;
  }
  TRY(travel(a,o,s,1),FP_TRAVEL);
 }
 return -1;
}

/* [130] r_mines_exit_light (NAV): A cleared mine only needs its ladder. */
static int r_mines_exit_light(FPAgent *a,const FPObservation *o,const FPConfig *cfg,FPScratch *s,FPRuleCtx *ctx,int *skill) {
 int act=-1;
 /* A cleared mine only needs its ladder. When ordinary exploration has not
  * found it in the time that 95% of descents need, search the small unlit
  * pockets. Searching them earlier spent every torch near the entrance and
  * left the rest of the floor dark for good. */
 if(a->level==2 && o->clear && ctx->f->down<0 && ctx->f->steps>=4000)TRY(light_unseen(a,o,s,8,600),FP_LIGHT);
 return -1;
}

