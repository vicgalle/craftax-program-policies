/* p_nav_entry (NAV prelude, second in the table): record how the current floor
 * visit began. On the first step after a floor change the previous observation
 * is still the old floor's (no rule can run between the change and this step). */
static int p_nav_entry(FPAgent *a,const FPObservation *o,const FPConfig *cfg,FPScratch *s,FPRuleCtx *ctx,int *skill) {
 (void)cfg;(void)s;(void)ctx;(void)skill;
 if(a->t && a->previous.level!=a->level){a->nav_ent_t=a->t+1;a->nav_ent_from=a->previous.level;a->nav_ent_hp10=(int)(o->health*10+0.5f);}
 return -1;
}
/* [6] p_fire_wait_reset (NAV): Reset the Fire ladder wait counter off the Fire ladders. */
static int p_fire_wait_reset(FPAgent *a,const FPObservation *o,const FPConfig *cfg,FPScratch *s,FPRuleCtx *ctx,int *skill) {
 if(ctx->fire && (a->level!=6 || (a->floors[6].up!=cell(a->r,a->c) && a->floors[6].down!=cell(a->r,a->c))))a->fire_wait=0;
 return -1;
}

/* [7] r_realm_descend_now (NAV): On an unlocked exit to the next unexplored realm (Fire/Ice), descend at once. */
static int r_realm_descend_now(FPAgent *a,const FPObservation *o,const FPConfig *cfg,FPScratch *s,FPRuleCtx *ctx,int *skill) {
 /* Floor travel happens before enemy attacks. Take an unlocked exit
  * immediately when it leads to the next unexplored realm. */
 if((a->level==6 || a->level==7) && !a->floors[a->level+1].seen && o->clear && a->floors[a->level].down==cell(a->r,a->c) && ctx->prep!=1)
  RET(FP_DESCEND,FP_TRAVEL);
 return -1;
}

